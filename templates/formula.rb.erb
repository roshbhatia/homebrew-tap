# This file is generated by hack/update.rb. Edit packages.yml instead.
class <%= package.fetch("class_name") %> < Formula
<% if package["python_resources"] -%>
  include Language::Python::Virtualenv
<% end -%>
  desc <%= package.fetch("description").dump %>
  homepage <%= package.fetch("homepage").dump %>
<% if fallback_artifact -%>
  url <%= fallback_artifact.fetch("url").dump %>
  sha256 <%= fallback_artifact.fetch("sha256").dump %>
<% end -%>
<% if package["explicit_version"] -%>
  version <%= release.fetch("version").dump %>
<% end -%>
  license <%= package.fetch("license").dump %>

<% package.fetch("bundle", []).each do |dependency| -%>
  depends_on <%= "roshbhatia/tap/#{dependency}".dump %>
<% end -%>
<% package.fetch("dependencies", []).each do |dependency| -%>
  depends_on <%= dependency.dump %>
<% end -%>
<% package.fetch("python_resources", []).each do |resource| -%>
  resource <%= resource.fetch("name").dump %> do
    url <%= resource.fetch("url").dump %>
    sha256 <%= resource.fetch("sha256").dump %>
  end
<% end -%>

<% systems.each do |system, architectures| -%>
  on_<%= system %> do
<% if architectures.one? -%>
    depends_on arch: :<%= architectures.values.first.fetch("requirement") %>

<% end -%>
<% architectures.each do |architecture, artifact| -%>
    on_<%= architecture %> do
      url <%= artifact.fetch("url").dump %>
      sha256 <%= artifact.fetch("sha256").dump %>
    end
<% end -%>
  end
<% end -%>

  def install
<% if package["bundle"] -%>
    (pkgshare/"providers.txt").write <%= (package.fetch("bundle").join("\n") + "\n").dump %>
<% else -%>
<% if package["archive_root"] -%>
    archive_root = Dir[<%= package.fetch("archive_root").gsub("%{version}", release.fetch("version")).dump %>]
                   .find { |path| File.directory?(path) } || buildpath

    <%= package["xdg_data"] ? "libexec" : "bin" %>.install "#{archive_root}/bin/<%= package.fetch("binary") %>"
    bash_completion.install "#{archive_root}/share/bash-completion/completions/<%= package.fetch("binary") %>"
    zsh_completion.install "#{archive_root}/share/zsh/site-functions/_<%= package.fetch("binary") %>"
    fish_completion.install "#{archive_root}/share/fish/vendor_completions.d/<%= package.fetch("binary") %>.fish"
    (share/"nushell/vendor/autoload").install "#{archive_root}/share/nushell/vendor/autoload/<%= package.fetch("binary") %>.nu"
    pkgshare.install Dir["#{archive_root}/share/<%= package.fetch("name") %>/*"]
<% else -%>
    <%= package["xdg_data"] || package["npm_runtime"] || package["script_environment"] || package["python_script"] ? "libexec" : "bin" %>.install <%= package.fetch("binary").dump %>
<% package.fetch("additional_binaries", []).each do |binary| -%>
    bin.install <%= binary.dump %>
<% end -%>
<% if package["completions"] == "generated" -%>
    generate_completions_from_executable(<%= package["xdg_data"] ? "libexec" : "bin" %>/<%= package.fetch("binary").dump %>, "completion")
    nu_completion = buildpath/<%= "#{package.fetch("binary")}.nu".dump %>
    nu_completion.write Utils.safe_popen_read(<%= package["xdg_data"] ? "libexec" : "bin" %>/<%= package.fetch("binary").dump %>, "completion", "nu")
    (share/"nushell/vendor/autoload").install nu_completion
<% elsif package["completions"] -%>
    bash_completion.install <%= package.fetch("completions").fetch("bash").dump %> => <%= package.fetch("binary").dump %>
    zsh_completion.install <%= package.fetch("completions").fetch("zsh").dump %> => <%= "_#{package.fetch("binary")}".dump %>
    fish_completion.install <%= package.fetch("completions").fetch("fish").dump %>
    (share/"nushell/vendor/autoload").install <%= package.fetch("completions").fetch("nu").dump %>
<% end -%>
<% end -%>
<% package.fetch("share", []).each do |asset| -%>
    (share/<%= File.dirname(asset.delete_prefix("share/")).dump %>).install <%= asset.dump %>
<% end -%>
<% if package["npm_runtime"] -%>
    (libexec/"runtime").install "runtime/package.json", "runtime/package-lock.json"
    system "npm", "ci", "--prefix", libexec/"runtime", "--legacy-peer-deps"
    inreplace libexec/"runtime/node_modules/calldiff/dist/languages/bash.js", '[".sh", ".bash"]', '[".sh", ".bash", ".zsh"]'
<% end -%>
<% package.fetch("libexec_assets", []).each do |asset| -%>
    (libexec/<%= File.dirname(asset).dump %>).install <%= asset.dump %>
<% end -%>
<% if package["python_resources"] -%>
    venv = virtualenv_create(libexec/"venv", Formula["python@3.13"].opt_bin/"python3.13")
    venv.pip_install resources
    (libexec/"process-tree").write <<~SH
      #!/bin/sh
      exec "#{libexec}/venv/bin/python" "#{libexec}/lib/process_tree.py" "$@"
    SH
    (libexec/"process-tree").chmod 0755
<% end -%>
<% if package["xdg_data"] || package["npm_runtime"] || package["script_environment"] || package["python_script"] -%>
    (bin/<%= package.fetch("binary").dump %>).write <<~SH
      #!/bin/sh
      export XDG_DATA_DIRS="#{HOMEBREW_PREFIX}/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
<% if package.fetch("dependencies", []).include?("bash") -%>
      export PATH="#{Formula["bash"].opt_bin}:$PATH"
<% end -%>
<% if package["script_environment"] -%>
      export ORC_PROVIDER_SELF="#{bin}/<%= package.fetch("binary") %>"
<% end -%>
<% package.fetch("script_environment", {}).each do |key, value| -%>
      export <%= key %>="#{libexec}/<%= value %>"
<% end -%>
<% if package["python_resources"] -%>
      export ORC_ZMX_TREE_HELPER="#{libexec}/process-tree"
<% end -%>
<% if package["npm_runtime"] -%>
      export PATH="#{libexec}/runtime/node_modules/.bin:$PATH"
<% end -%>
      exec <%= package["python_script"] ? '"#{Formula["python@3.13"].opt_bin}/python3.13" ' : '' %>"#{libexec}/<%= package.fetch("binary") %>" "$@"
    SH
    (bin/<%= package.fetch("binary").dump %>).chmod 0755
<% end -%>
<% end -%>
  end

  test do
<% if package["bundle"] -%>
    assert_path_exists pkgshare/"providers.txt"
<% elsif package["python_script"] -%>
    request = { version: "provider/v1", kind: "request", requestId: "brew-test", capability: "picker.describe", input: {} }.to_json
    response = JSON.parse(pipe_output("#{bin}/<%= package.fetch("binary") %>", request, 0))
    assert_equal "brew-test", response.fetch("requestId")
    assert_equal "ok", response.fetch("status")
    assert_predicate response.fetch("output").fetch("title"), :present?
<% elsif package["kind"] == "provider" -%>
    assert_path_exists bin/<%= package.fetch("binary").dump %>
<% else -%>
    assert_match <%= package.fetch("binary").dump %>, shell_output("#{bin}/<%= package.fetch("binary") %> --help 2>&1")
<% end -%>
  end
end
